# ───────────────────────────── YEEZY PODS · variables de entorno ─────────────────────────────
# Copiá este archivo a `.env` (local) o cargá las variables en Vercel → Settings → Environment Variables.

# Postgres. Local: cualquier Postgres. Producción: la "Connection string" de Supabase
# (Project Settings → Database → Connection string → URI, modo "Transaction pooler" recomendado en Vercel).
# El esquema y el seed se crean solos en el primer arranque (src/db/bootstrap.ts).
DATABASE_URL=postgresql://postgres.javkmpfkmmsqvbnpgcdv:ysypodss123@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Acceso al panel /admin: SOLO este email + contraseña pueden ingresar.
ADMIN_EMAIL=santiagojeda873@gmail.com
ADMIN_PASSWORD=ysypodss123

# Secreto para firmar la cookie de sesión del admin (cualquier string largo y aleatorio).
# Generalo con: openssl rand -hex 32
BETTER_AUTH_SECRET=f8054a282e925b41e01fd2a7104b85ff3c46db1c659e74595abb067375ac14c7

# SerpApi (Google Images) para la búsqueda automática de imágenes. https://serpapi.com
# Si queda vacía, los productos se publican igual con el modelo 3D del color del sabor.
SERPAPI_KEY=f336fb96106b88c3e58827ca1136d1aff12262b0f8db27633e63856bc2c92a41

# WhatsApp de ventas (código de país + número, sin + ni espacios).
NEXT_PUBLIC_WHATSAPP_NUMBER=5493765100878

# URL pública del sitio (para OG image). En Vercel es opcional: se detecta sola.
